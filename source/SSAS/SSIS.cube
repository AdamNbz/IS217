  <MdxScripts>
    <MdxScript dwd:design-time-name="e85ee63a-72e4-46c4-ab4c-d75439075b4f">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE;
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Price]
 AS IIF([Measures].[FACT CAR LISTING Count]=0, NULL,
      [Measures].[Price Usd] / [Measures].[FACT CAR LISTING Count]), 
FORMAT_STRING = "#,0.00", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Averages' ,  ASSOCIATED_MEASURE_GROUP = 'FACT CAR LISTING'  ;  

CREATE MEMBER CURRENTCUBE.[Measures].[Avg Mileage]
 AS IIF([Measures].[FACT CAR LISTING Count]=0, NULL,
      [Measures].[Mileage Km] / [Measures].[FACT CAR LISTING Count]), 
FORMAT_STRING = "#,0", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Averages' ,  ASSOCIATED_MEASURE_GROUP = 'FACT CAR LISTING';  

CREATE MEMBER CURRENTCUBE.[Measures].[Avg Price per 1k km]
 AS IIF([Measures].[FACT CAR LISTING Count]=0, NULL,
      [Measures].[Price Per 1k Km] / [Measures].[FACT CAR LISTING Count]), 
FORMAT_STRING = "#,0.00", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Averages' ,  ASSOCIATED_MEASURE_GROUP = 'FACT CAR LISTING';  

CREATE MEMBER CURRENTCUBE.[Measures].[Overpriced %]
 AS IIF([Measures].[FACT CAR LISTING Count]=0, NULL,
      [Measures].[Overpriced Flag] / [Measures].[FACT CAR LISTING Count]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Percentages' ,  ASSOCIATED_MEASURE_GROUP = 'FACT CAR LISTING';  

CREATE MEMBER CURRENTCUBE.[Measures].[Market Share %]
 AS IIF(([Measures].[FACT CAR LISTING Count],
       [DIM BRAND].[Brand Name].DefaultMember)=0, NULL,
      [Measures].[FACT CAR LISTING Count] /
      ([Measures].[FACT CAR LISTING Count],
       [DIM BRAND].[Brand Name].DefaultMember)), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Percentages' ,  ASSOCIATED_MEASURE_GROUP = 'FACT CAR LISTING'; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>