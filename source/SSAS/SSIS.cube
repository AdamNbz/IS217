  <Source dwd:design-time-name="0b2a9bea-7180-4223-946c-0d0bc9371865">
    <DataSourceViewID>SSIS</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="12a87860-4dcd-44e7-85e1-f5b9fb17d6f2">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE;

-- Trung bình giá
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Price] AS 
IIF(
    [Measures].[FACT CAR LISTING Count] = 0,
    NULL,
    [Measures].[Price Usd] / [Measures].[FACT CAR LISTING Count]
)
,FORMAT_STRING = "Currency"
,VISIBLE = 1;

-- Trung bình giá / 1,000 km
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Price per 1k km] AS 
IIF(
    [Measures].[FACT CAR LISTING Count] = 0,
    NULL,
    [Measures].[Price Per 1k Km] / [Measures].[FACT CAR LISTING Count]
)
,FORMAT_STRING = "Currency"
,VISIBLE = 1;

-- Đếm xe bị chém giá
CREATE MEMBER CURRENTCUBE.[Measures].[Overpriced Count]
AS SUM(
    EXISTING [FACT CAR LISTING].[Listing Id].Members,
    IIF( [Measures].[Is Overpriced], 1, NULL)
)
,VISIBLE = 1;

-- Số km trung bình mỗi xe
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Mileage Km] AS 
IIF(
    [Measures].[FACT CAR LISTING Count] = 0,
    NULL,
    [Measures].[Mileage Km] / [Measures].[FACT CAR LISTING Count]
)
,FORMAT_STRING = "#,##0"
,VISIBLE = 1;

-- Thị phần theo số lượng xe (Market Share %)
CREATE MEMBER CURRENTCUBE.[Measures].[Market Share %] AS 
IIF(
       [Measures].[FACT CAR LISTING Count] = 0,
       NULL,
       [Measures].[FACT CAR LISTING Count] /
       SUM(
           [DIM BRAND].[Brand-Model].[Brand].Members,
           [Measures].[FACT CAR LISTING Count]
       )
   )
,FORMAT_STRING = "Percent"
,VISIBLE = 1;

-- Tỷ lệ xe bị chém giá
CREATE MEMBER CURRENTCUBE.[Measures].[Overpriced %] AS 
IIF(
    [Measures].[FACT CAR LISTING Count] = 0,
    NULL,
    [Measures].[Overpriced Count] / [Measures].[FACT CAR LISTING Count] - 1
)
,FORMAT_STRING = "Percent"
,VISIBLE = 1;

-- Median Model Avg
CREATE MEMBER CURRENTCUBE.[Measures].[Median Model Avg] AS
MEDIAN(
    EXISTING [DIM BRAND].[Model].Members,
    [Measures].[Avg Price]
)</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>